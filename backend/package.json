{
  "name": "teddypups-backend",
  "version": "1.0.0",
  "description": "Backend API for TeddyPups Dubai",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm install && (test -d ../frontend && npm --prefix ../frontend install && npm --prefix ../frontend run build || true)",
    "build:render": "npm install && (test -d ../frontend && npm --prefix ../frontend install && npm --prefix ../frontend run build || true)",
    "seed": "node seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
