<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Prevent rewriting existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Rewrite all other URLs to index.html for Single Page Application (SPA) routing
  RewriteRule ^ index.html [L]
</IfModule>

# Caching & Security headers
<IfModule mod_headers.c>
  # Disable caching for index.html so updates are immediately visible
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  
  # Cache static assets (CSS, JS, images, fonts, videos)
  <FilesMatch "\.(css|js|webp|svg|webm|png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
